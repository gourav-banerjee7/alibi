# Gemini API key from https://aistudio.google.com/apikey
# Leave empty to play with scripted voices (no AI calls at all).
# Tip: use a key from a Google Cloud project with NO billing attached; the free tier then
# simply stops at its quota instead of charging you.
GEMINI_API_KEY=

# Model id. Check the current name in Google AI Studio before deploying.
GEMINI_MODEL=gemini-3.5-flash

# Brakes, per server instance (see lib/server/ratelimit.ts).
RATE_LIMIT_PER_MINUTE=40
DAILY_REQUEST_CAP=1500
